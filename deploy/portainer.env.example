# Copy variable names into the Portainer stack environment and fill them there.
# Do not commit a file with real credentials.
TAULELLARI_IMAGE=taulellari:local
# Generate two DIFFERENT values with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
MAPBOX_ACCESS_TOKEN=
CARTO_API_KEY=
# DATABASE_URL and SESSION_COOKIE_SECURE=false are set by docker-compose.yml.
